---
const destinos = [
  { name: 'Tours en Cusco', tours: 26, image: 'https://upload.wikimedia.org/wikipedia/commons/6/6e/Plaza_de_Armas_-_Cusco.jpg' },
  { name: 'Tours en Lima', tours: 10, image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/7/7e/Lima%2C_Peru%E2%80%A6the_Plaza_de_Armas_de_Lima_by_day_%288444360764%29.jpg/1280px-Lima%2C_Peru%E2%80%A6the_Plaza_de_Armas_de_Lima_by_day_%288444360764%29.jpg' },
  { name: 'Tours en Arequipa', tours: 7, image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/7/74/In_Aerquipa_Peru%2C%E2%80%A6Plaza_de_Armas_%288443293545%29.jpg/1280px-In_Aerquipa_Peru%2C%E2%80%A6Plaza_de_Armas_%288443293545%29.jpg' },
  { name: 'Tours en Ica', tours: 7, image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Oasis_de_Huacachina%2C_Ica%2C_Per%C3%BA%2C_2015-07-29%2C_DD_18.JPG/1280px-Oasis_de_Huacachina%2C_Ica%2C_Per%C3%BA%2C_2015-07-29%2C_DD_18.JPG' },
];
---
<section class="section" style="background-color: #F3F8F3;">
  <div class="container-pb">
    <div class="text-center mb-12">
      <span class="script-title">Destinos</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-2">Estos destinos te esperan… Más de lo que imaginas</h2>
      <p class="text-sm text-gray-500 mt-3 max-w-xl mx-auto">Explora los mejores destinos de Perú: Cusco, Lima, Arequipa y Puno. Cultura, historia y paisajes únicos te esperan en cada rincón. ¡Descúbrelos todos!</p>
    </div>
    <div class="swiper destinos-swiper">
      <div class="swiper-wrapper">
        {destinos.map(d => (
          <div class="swiper-slide">
            <a href="#" class="block relative overflow-hidden group" style="height: 420px; border-radius: 1rem;">
              <img src={d.image} alt={d.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
              <div class="absolute bottom-0 left-0 right-0 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.20) 50%, transparent 100%); padding: 4rem 1.5rem 1.5rem;">
                <h3 class="text-xl font-bold text-white mb-1">{d.name}</h3>
                <span class="text-sm font-bold text-white/80">{d.tours} Tours</span>
              </div>
            </a>
          </div>
        ))}
      </div>
      <div class="swiper-pagination !relative !mt-6"></div>
    </div>
  </div>
</section>
<script is:inline>
  window.addEventListener('load', () => {
    if (window.Swiper) new Swiper('.destinos-swiper', {
      slidesPerView: 1, spaceBetween: 20, pagination: { el: '.destinos-swiper .swiper-pagination', clickable: true },
      breakpoints: { 640: { slidesPerView: 2 }, 1024: { slidesPerView: 3 }, 1280: { slidesPerView: 4 } }
    });
  });
</script>
