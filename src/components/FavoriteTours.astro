---
const tours = [
  // Fila 1 (2 tarjetas - más altas)
  {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/Machu_Picchu%2C_2023_%28012%29.jpg/1280px-Machu_Picchu%2C_2023_%28012%29.jpg',
    title: 'Cusco + Valle Sagrado + Machu Picchu',
    duration: '4 Días / 3 Noches',
    price: '462',
    description: 'Explora la capital del Imperio Inca, el místico Valle Sagrado y la maravilla del mundo: Machu Picchu.',
    row: 'top',
  },
  {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/7/7e/Lima%2C_Peru%E2%80%A6the_Plaza_de_Armas_de_Lima_by_day_%288444360764%29.jpg/1280px-Lima%2C_Peru%E2%80%A6the_Plaza_de_Armas_de_Lima_by_day_%288444360764%29.jpg',
    title: 'Lima + Paracas + Ica',
    duration: '9 Días / 8 Noches',
    price: '690',
    description: 'Desde la vibrante capital peruana hasta las dunas de Ica y la magia de la Reserva Nacional de Paracas.',
    row: 'top',
  },
  // Fila 2 (3 tarjetas - medianas)
  {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/24/Monta%C3%B1aarcoirisperuabanto.jpg/1280px-Monta%C3%B1aarcoirisperuabanto.jpg',
    title: 'Cusco + Machu Picchu + Montaña 7 Colores',
    duration: '4 Días / 3 Noches',
    price: '447',
    description: 'Machu Picchu y el espectáculo natural de la Montaña Arcoíris, uno de los paisajes más únicos del mundo.',
    row: 'mid',
  },
  {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/08/Urubamba_-_Valle_Sagrado_3.JPG/1280px-Urubamba_-_Valle_Sagrado_3.JPG',
    title: 'Tour Valle Sagrado de los Incas',
    duration: 'Full Day',
    price: '39',
    description: 'Recorre Pisac, Ollantaytambo y los mercados artesanales del corazón del Valle Sagrado inca.',
    row: 'mid',
  },
  {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Oasis_de_Huacachina%2C_Ica%2C_Per%C3%BA%2C_2015-07-29%2C_DD_18.JPG/1280px-Oasis_de_Huacachina%2C_Ica%2C_Per%C3%BA%2C_2015-07-29%2C_DD_18.JPG',
    title: 'Lima + Paracas + Huacachina',
    duration: '7 Días / 6 Noches',
    price: '589',
    description: 'El oasis de Huacachina, sandboard en las dunas gigantes y la biodiversidad única de Paracas.',
    row: 'mid',
  },
  // Fila 3 (2 tarjetas - más altas)
  {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Humantay_Lake.jpg/1280px-Humantay_Lake.jpg',
    title: 'Cusco + Machu Picchu + Laguna Humantay',
    duration: '5 Días / 4 Noches',
    price: '486',
    description: 'Cultura, historia y naturaleza: ruinas incas, la ciudadela de Machu Picchu y la turquesa laguna Humantay.',
    row: 'bottom',
  },
  {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Paracas_National_Reserve._Ica%2C_Peru.jpg/1280px-Paracas_National_Reserve._Ica%2C_Peru.jpg',
    title: 'Lima + Paracas',
    duration: '8 Días / 7 Noches',
    price: '653',
    description: 'Lima colonial y moderna, combinada con la riqueza natural y marina de la Reserva Nacional de Paracas.',
    row: 'bottom',
  },
];

const topTours = tours.filter(t => t.row === 'top');
const midTours = tours.filter(t => t.row === 'mid');
---

<section id="favoritos" class="section" style="background-color: #F3F8F3;">
  <div class="container-pb">
    <div class="text-center mb-10">
      <span class="script-title">Experiencias Imperdibles</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-2 tracking-wide">Los Paquetes Favoritos de Nuestros Clientes</h2>
      <p class="text-sm text-gray-500 mt-3 max-w-xl mx-auto">Una gran variedad de experiencias, totalmente personalizables y especialmente seleccionadas según las opiniones de nuestros clientes. Nuestros mejores viajes en Perú están a tu disposición con la atención de alta calidad que nos caracteriza.</p>
    </div>

    <!-- Fila 1: 2 tarjetas altas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      {topTours.map(t => (
        <a href="#" class="group relative block overflow-hidden">
          <img src={t.image} alt={t.title} class="w-full h-[480px] object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute bottom-0 left-0 right-0 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 50%, transparent 100%); padding: 4rem 1.5rem 1.5rem;">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-bold tracking-widest uppercase text-white/90">{t.duration}</span>
              <span class="text-[11px] font-bold text-white/90">Desde <span class="text-sm text-white">${t.price}<span class="font-bold text-xs"> /pp</span></span></span>
            </div>
            <h3 class="text-lg font-bold leading-snug mb-1 text-white">{t.title}</h3>
            <p class="text-xs font-bold text-white/80 leading-relaxed line-clamp-1">{t.description}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Fila 2: 3 tarjetas medianas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {midTours.map(t => (
        <a href="#" class="group relative block overflow-hidden">
          <img src={t.image} alt={t.title} class="w-full h-[380px] object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute bottom-0 left-0 right-0 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 50%, transparent 100%); padding: 3rem 1.25rem 1.25rem;">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold tracking-widest uppercase text-white/90">{t.duration}</span>
              <span class="text-[10px] font-bold text-white/90">Desde <span class="text-xs text-white">${t.price}<span class="font-bold"> /pp</span></span></span>
            </div>
            <h3 class="text-sm font-bold leading-snug mb-1 text-white">{t.title}</h3>
            <p class="text-[11px] font-bold text-white/80 leading-relaxed line-clamp-1">{t.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
