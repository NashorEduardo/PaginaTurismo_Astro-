---
const PLACE_ID = 'ChIJK_vMJWBfiioRH9_2oYWbNhY';
const API_KEY  = import.meta.env.GOOGLE_PLACES_API_KEY;

interface Review {
  author_name: string;
  rating: number;
  text: string;
  relative_time_description: string;
  profile_photo_url: string;
}

let reviews: Review[] = [];
let totalRating  = 0;
let totalReviews = 0;
let fetchError   = false;

if (API_KEY && API_KEY !== 'TU_API_KEY_AQUI') {
  try {
    const url = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${PLACE_ID}&fields=name,rating,user_ratings_total,reviews&key=${API_KEY}&language=es&reviews_sort=newest`;
    const res  = await fetch(url);
    const data = await res.json();

    if (data.status === 'OK') {
      reviews      = (data.result.reviews ?? []).filter((r: Review) => r.rating >= 4);
      totalRating  = data.result.rating ?? 0;
      totalReviews = data.result.user_ratings_total ?? 0;
    } else {
      fetchError = true;
    }
  } catch {
    fetchError = true;
  }
}

const hasData = reviews.length > 0;
---

<section class="section bg-softgreen">
  <div class="container-pb">
    <div class="text-center mb-3">
      <span class="script-title">Reseñas</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-2 mb-4">Lo Que Dicen Nuestros Viajeros</h2>
    </div>

    <!-- Badge Google rating -->
    <div class="flex items-center justify-center gap-3 mb-10">
      <i class="bi bi-google text-2xl text-[#4285F4]"></i>
      <div class="flex text-gold text-xl">
        {Array.from({ length: 5 }).map(() => <i class="bi bi-star-fill"></i>)}
      </div>
      <span class="font-bold text-lg">
        {hasData ? `${totalRating.toFixed(1)} · ${totalReviews} reseñas` : '5.0 · Google Reviews'}
      </span>
    </div>

    {fetchError && (
      <p class="text-center text-sm text-gray-500 mb-6">
        No se pudieron cargar las reseñas en este momento.
      </p>
    )}

    {!API_KEY || API_KEY === 'TU_API_KEY_AQUI' ? (
      <p class="text-center text-sm text-amber-600 bg-amber-50 rounded-xl px-6 py-4 max-w-xl mx-auto">
        Configura <code>GOOGLE_PLACES_API_KEY</code> en el archivo <code>.env</code> para mostrar las reseñas reales.
      </p>
    ) : hasData ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {reviews.map((r) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition flex flex-col gap-4">
            <!-- Encabezado: avatar + nombre -->
            <div class="flex items-center gap-3">
              <img
                src={r.profile_photo_url}
                alt={r.author_name}
                class="w-11 h-11 rounded-full object-cover"
                onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&background=C9A84C&color=fff&size=44'"
              />
              <div>
                <p class="font-bold text-sm leading-tight">{r.author_name}</p>
                <p class="text-xs text-gray-400">{r.relative_time_description}</p>
              </div>
              <!-- Logo Google pequeño -->
              <i class="bi bi-google text-[#4285F4] ml-auto text-lg"></i>
            </div>

            <!-- Estrellas -->
            <div class="flex text-gold gap-0.5">
              {Array.from({ length: 5 }).map((_, i) => (
                <i class={`bi ${i < r.rating ? 'bi-star-fill' : 'bi-star'} text-sm`}></i>
              ))}
            </div>

            <!-- Texto -->
            <p class="text-gray-600 text-sm leading-relaxed line-clamp-5">{r.text}</p>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-gray-500 text-sm">No hay reseñas disponibles aún.</p>
    )}



  
    <!-- CTA Google Maps -->
    <div class="text-center mt-10">
      <a
        href={`https://search.google.com/local/reviews?placeid=${PLACE_ID}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-gray-300 rounded-full px-6 py-2.5 text-sm font-semibold hover:bg-white hover:shadow transition"
      >
        <i class="bi bi-google text-[#4285F4]"></i>
        Ver todas las reseñas en Google
      </a>
    </div>
  </div>
</section>
