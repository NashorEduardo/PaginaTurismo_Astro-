---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const certLogos = [
  { src: 'https://gercetur.com.pe/wp-content/uploads/2025/11/LOGO-POSITIVO-scaled-e1763582114614.png', alt: 'Gercetur' },
  { src: 'https://www.perubeyond.com/wp-content/uploads/2026/01/marca-peru-peru-beyond-2_1_-748x1024.webp', alt: 'Marca Perú' },
  { src: 'https://www.perubeyond.com/wp-content/uploads/2026/01/tripadvisor-peru-beyond_1_.webp', alt: 'TripAdvisor' },
  { src: 'https://www.perubeyond.com/wp-content/uploads/2026/01/protegeme-peru-beyond_1_.webp', alt: 'Protegeme' },
  { src: 'https://www.wayraqperu.com/wp-content/uploads/mincetur.png', alt: 'Mincetur' },
];
---

<Layout>
  <Header />

  <!-- IMAGEN FIJA DE FONDO -->
  <div class="fixed inset-0 -z-10">
    <img
      src="https://images.unsplash.com/photo-1744296818983-fd0ad8636643?q=80&w=1920&auto=format&fit=crop"
      alt="Fondo Sobre Nosotros"
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/35"></div>
  </div>

  <!-- HERO -->
  <section class="h-[55vh] flex items-center justify-center text-center text-white px-4 pt-20">
    <div>
      <p class="script-title text-white/90 mb-3">Peru Beyond</p>
      <h1 class="text-5xl md:text-7xl font-extrabold drop-shadow-2xl leading-tight">
        Sobre <span class="text-gold">Nosotros</span>
      </h1>
      <nav class="flex items-center justify-center gap-2 text-sm mt-5 text-white/60">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <i class="bi bi-chevron-right text-[10px]"></i>
        <span class="text-white/90">Sobre Nosotros</span>
      </nav>
    </div>
  </section>

  <!-- SECCIONES -->
  <div class="relative z-10 space-y-6 px-4 md:px-8 max-w-7xl mx-auto pb-0">

    <!-- ══ SECCIÓN 1: Viaja con PeruBeyond ══ -->
    <div class="rounded-3xl shadow-2xl overflow-hidden" style="background-color:#F0FDF4">
      <div class="p-8 md:p-12">
        <div class="grid md:grid-cols-2 gap-12 items-center">

          <!-- Texto + features -->
          <div>
            <span class="script-title">Sobre Nosotros</span>
            <h2 class="text-3xl md:text-4xl font-extrabold mt-2 mb-4 leading-tight text-gray-900">
              Viaja con PeruBeyond y vive algo inolvidable.
            </h2>
            <p class="text-gray-600 mb-8 leading-relaxed">
              Somos una agencia de viajes dedicada a ofrecer tours auténticos, seguros y personalizados. Nuestro compromiso es mostrarte lo mejor del Perú: su cultura, historia, paisajes y la calidez de su gente, a través de experiencias cuidadosamente diseñadas.
            </p>

            <div class="grid grid-cols-2 gap-3 mb-8">
              {[
                { icon: 'bi-shield-check',  label: 'Seguridad Ante Todo',        bg: '#dcfce7' },
                { icon: 'bi-person-check',  label: 'Guías De Confianza',         bg: '#fef3c7' },
                { icon: 'bi-headset',       label: 'Atención Personalizada',     bg: '#dcfce7' },
                { icon: 'bi-patch-check',   label: 'Compromiso y Transparencia', bg: '#fef3c7' },
              ].map(f => (
                <div class="flex items-center gap-3 rounded-xl p-4" style={`background-color:${f.bg}`}>
                  <i class={`bi ${f.icon} text-green-600 text-2xl flex-shrink-0`}></i>
                  <span class="font-semibold text-gray-800 text-sm leading-tight">{f.label}</span>
                </div>
              ))}
            </div>

            <div class="flex items-center gap-4">
              <a href="/" class="btn-primary px-6 py-3 rounded-full font-bold shadow-md">Descubra Más</a>
              <a href="#" class="flex items-center gap-2 text-gray-700 font-semibold hover:text-green-600 transition-colors">
                <span class="w-11 h-11 rounded-full border-2 border-gray-300 flex items-center justify-center hover:border-green-500 transition-colors">
                  <i class="bi bi-play-fill text-green-600 ml-0.5"></i>
                </span>
                Ver Tour
              </a>
            </div>
          </div>

          <!-- Foto + stats -->
          <div class="relative pb-10">
            <img
              src="https://www.perubeyond.com/wp-content/uploads/2025/07/team-perubeyond.jpg"
              alt="Equipo Peru Beyond"
              class="w-full rounded-2xl object-cover h-[380px] shadow-xl"
            />
            <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-[95%] bg-white rounded-2xl shadow-xl p-4 grid grid-cols-4 gap-2 text-center border border-green-100">
              {[
                { num: '10k+', label: 'Viajeros Felices' },
                { num: '5k+',  label: 'Tours Exitosos' },
                { num: '98%',  label: 'Opiniones Positivas' },
                { num: '25',   label: 'Guías Certificados' },
              ].map(s => (
                <div class="py-1">
                  <p class="text-green-600 font-extrabold text-xl leading-none">{s.num}</p>
                  <p class="text-gray-500 text-[10px] mt-1 leading-tight">{s.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Rating -->
        <div class="mt-14 flex flex-wrap items-center justify-center gap-4 bg-white rounded-2xl p-5 border border-green-100 shadow-sm">
          <div class="flex text-amber-400 text-xl gap-0.5">★★★★★</div>
          <div class="text-center md:text-left">
            <p class="font-bold text-gray-800">Excellent! <span class="text-green-600">5.0</span> Rating out of 5.0</p>
          </div>
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Tripadvisor_2025_Logo.svg/500px-Tripadvisor_2025_Logo.svg.png"
            alt="Tripadvisor"
            class="h-7"
          />
        </div>
      </div>
    </div>

    <!-- ══ SECCIÓN 2: Por Qué Elegirnos ══ -->
    <div class="rounded-3xl shadow-2xl overflow-hidden" style="background-color:#F0FDF4">
      <div class="p-8 md:p-12">
        <div class="text-center mb-10">
          <span class="script-title">Quiénes Somos</span>
          <h2 class="text-3xl md:text-4xl font-extrabold mt-2 text-gray-900">Por Qué Elegir PeruBeyond</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { icon: 'bi-globe2',           title: 'Cobertura Mundial',    desc: 'Explora lo más espectacular de Perú con nosotros.' },
            { icon: 'bi-tag',              title: 'Precios Competitivos', desc: 'Ofrecemos las mejores tarifas sin sacrificar calidad.' },
            { icon: 'bi-lightning-charge', title: 'Reserva Rápida',       desc: 'Proceso sencillo y ágil para que planifiques tu viaje sin estrés.' },
            { icon: 'bi-person-badge',     title: 'Tours Guiados',        desc: 'Experiencias acompañadas por guías expertos y certificados.' },
            { icon: 'bi-headset',          title: 'Soporte 24/7',         desc: 'Atención continua para resolver tus dudas y apoyarte en todo momento.' },
            { icon: 'bi-arrow-left-right', title: 'Flexibilidad Total',   desc: 'Adaptamos los tours a tus necesidades y cambios de último minuto.' },
          ].map(i => (
            <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow border border-green-100">
              <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600 text-xl flex-shrink-0">
                <i class={`bi ${i.icon}`}></i>
              </div>
              <div>
                <h3 class="font-bold text-gray-800 mb-1">{i.title}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{i.desc}</p>
              </div>
              
            </div>
          ))}
        </div>
      </div>
    </div>
    </p></p>  
  </div>
  </p> </p>
  <Footer />
  
</Layout>
